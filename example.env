# ---- Server ----
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/speed_math
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000

# ---- Auth / JWT ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-too-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
COOKIE_SECURE=false

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
SCORE_RATE_LIMIT_WINDOW_MS=60000
SCORE_RATE_LIMIT_MAX_REQUESTS=15

# ---- Game rules (server-side validation) ----
GAME_DURATION_SECONDS=30
MAX_SCORE_PER_GAME=60
MIN_SECONDS_BETWEEN_SUBMISSIONS=25

# ---- Leaderboard ----
LEADERBOARD_DEFAULT_LIMIT=20
LEADERBOARD_MAX_LIMIT=100
